{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flat-jobs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flat-jobs-db",
      "database_id": "9d882f6f-7dec-42ee-912c-21cc8310d6b2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_IDS": "",
    "APPLE_CLIENT_IDS": "",
    "CORS_ORIGIN": "*"
  }
}
